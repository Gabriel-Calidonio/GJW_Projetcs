    component "GenericRepository\n(Persistência Base Dinâmica)" as GenRepo #FEF9C3;line:A16207
    component "Repositórios Específicos\n(UsuarioRepository, ClienteRepository,\netc. - Consultas Customizadas)" as SpecRepos #FEF9C3;line:A16207
}

package "Mapeador de Banco (Data Mapper)" as MapperLayer #FAF5FF;line:9333EA {
    component "DataMapper\n(Mapeamento SQL <=> Objetos de Domínio)" as DataMapper #F3E8FF;line:7E22CE
    component "QueryBuilder\n(Construção dinâmica de SQL)" as QueryBuilder #F3E8FF;line:7E22CE
    component "SchemaValidator\n(Validação de Schema/Tabelas)" as Validator #F3E8FF;line:7E22CE
