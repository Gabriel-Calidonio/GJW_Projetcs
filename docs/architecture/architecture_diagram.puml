package "Apresentação (View - Frontend)" as ViewLayer #FFF7ED;line:F97316 {
    component "Thymeleaf Templates\n(HTML5 + Bootstrap)" as Templates #FFEDD5;line:EA580C
    component "JavaScript (delete.js, etc.)\n(Requisições Fetch/AJAX)" as JS #FFEDD5;line:EA580C
}

package "Controle (Controllers & Interceptors)" as ControllerLayer #F0F9FF;line:0284C7 {
    component "GenericViewController\n(Rotas Dinâmicas de View)" as GenericView #E0F2FE;line:0369A1
    component "JsonController\n(API REST - Operações CRUD)" as JsonCtrl #E0F2FE;line:0369A1
    component "LoginController\n(Autenticação e Sessão)" as LoginCtrl #E0F2FE;line:0369A1
    component "AdminInterceptor\n(Controle de Acesso/Segurança)" as Interceptor #E0F2FE;line:0369A1
}

package "Mapeamento HTTP/Request (DTO / Reflection)" as UtilLayer #F5F3FF;line:7C3AED {
    component "EntityMapper\n(Popula entidades via HTTP Request)" as HTTPMapper #EDE9FE;line:6D28D9
    component "SimpleObjectFactory\n(Instanciação dinâmica de IEntity)" as Factory #EDE9FE;line:6D28D9
}

package "Serviços (Service Layer & Transações)" as ServiceLayer #F0FDF4;line:16A34A {
    interface "IService<T>\n(Interface Base de Serviço)" as IService #DCFCE7;line:15803D
    component "GenericService\n(Orquestrador CRUD Genérico)" as GenService #DCFCE7;line:15803D
    component "Serviços Específicos\n(UsuarioService, ClienteService,\netc. - Regras de Negócio)" as SpecServices #DCFCE7;line:15803D
    component "ServiceRegistry\n(Resolução Dinâmica de Serviços)" as ServiceRegistry #DCFCE7;line:15803D
